{
  "name": "ai-engineering-dictionary",
  "version": "1.0.0",
  "private": true,
  "description": "The AI Engineering Dictionary by Fred Osei-Adu",
  "author": "Fred Osei-Adu",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "npx serve out",
    "validate": "tsx scripts/validate-content.ts",
    "audio:manifest": "tsx scripts/build-audio-manifest.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test \"lib/**/*.test.ts\"",
    "search:assets": "tsx scripts/fetch-search-assets.ts",
    "prebuild": "npm run search:assets"
  },
  "dependencies": {
    "@huggingface/transformers": "^4.3.2",
    "gray-matter": "^4.0.3",
    "minisearch": "^7.2.0",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
